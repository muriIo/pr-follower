# Copy to .env (git-ignored) for `make dev`. Values here are read by docker-compose.local.yml.

# GitHub App used for sign-in (ADR-0010). Create one at GitHub > Settings > Developer settings >
# GitHub Apps with Callback URL http://localhost:4200/api/v1/auth/github/callback and
# "Expire user authorization tokens" enabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The app's URL name: https://github.com/apps/<slug>. Enables the "install / add account" links
# on the Import repository screen. Set the app's Setup URL to http://localhost:4200/.
GITHUB_APP_SLUG=

# Optional: the app's own credentials (App ID, and a private key generated on the app's page).
# With them, reads that have no signed-in user behind them (webhooks) use the app's installation
# token. The key is a single line with the newlines written as \n; keep it in this git-ignored file.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Shared secret configured on the GitHub App webhook.
GITHUB_WEBHOOK_SECRET=

# Optional: 32 random bytes, base64 (openssl rand -base64 32). Overrides the local dev key.
TOKEN_ENCRYPTION_KEY=

# Optional (ADR-0015): only members of these GitHub organizations can sign in, comma-separated and
# case-insensitive (e.g. acme,acme-labs). Empty: sign-in is open to every GitHub account. Needs
# GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY, the app installed on each organization, and its
# organization "Members: read" permission. Users who leave lose their access within 15 minutes.
ALLOWED_GITHUB_ORGS=
