# Copy to .env next to compose.yml and fill in every value. Keep .env out of version control and
# readable only by you (chmod 600 .env). INSTALL.md explains each one.

# --- Where and what -----------------------------------------------------------------------------
# The domain users open. It must point at this machine (DNS A/AAAA record).
DOMAIN=prfollower.example.com
# The release to run: a tag from https://github.com/muriIo/pr-follower/releases, e.g. 0.1.0.
PR_FOLLOWER_VERSION=0.1.0
# REGISTRY=ghcr.io/muriio          # change only if you build and push the images yourself
# HTTP_PORT=80                      # change only behind another proxy or for a local try
# HTTPS_PORT=443

# --- Database -------------------------------------------------------------------------------------
# The bundled Postgres runs while this line is here.
COMPOSE_PROFILES=bundled-db
# Its password: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Using a managed Postgres instead? Delete COMPOSE_PROFILES above and set its URL here:
# DATABASE_URL=postgres://prfollower:PASSWORD@HOST:5432/pr_follower?sslmode=require

# --- GitHub App (INSTALL.md §1) -------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The same value as the app's webhook secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The app's private key goes in secrets/github-app.pem, not here.

# --- Encryption -------------------------------------------------------------------------------------
# Encrypts the stored GitHub tokens: openssl rand -base64 32. Changing it signs everyone out.
TOKEN_ENCRYPTION_KEY=
