# Copy to .env next to compose.yml and fill in every value. Keep .env out of version control and
# readable only by you (chmod 600 .env). INSTALL.md explains each one.

# --- Where and what -----------------------------------------------------------------------------
# The domain users open. It must point at this machine (DNS A/AAAA record).
DOMAIN=prfollower.example.com
# The release to run, from https://github.com/muriIo/pr-follower/releases: the release name without
# the "v" (release v0.1.0 -> 0.1.0). Check its images first with the commands in its release notes.
PR_FOLLOWER_VERSION=0.1.0
# REGISTRY=ghcr.io/muriio          # change only if you build and push the images yourself
# HTTP_PORT=80                      # change only behind another proxy or for a local try
# HTTPS_PORT=443

# --- Database -------------------------------------------------------------------------------------
# The bundled Postgres runs while this line is here.
COMPOSE_PROFILES=bundled-db
# Its password: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# Using a managed Postgres instead? Delete COMPOSE_PROFILES above and set its URL here. verify-full
# also checks the server's certificate against the provider's CA file: put it in secrets/db-ca.pem
# and uncomment its line under the api's volumes in compose.yml (sslmode=require only encrypts).
# DATABASE_URL=postgres://prfollower:PASSWORD@HOST:5432/pr_follower?sslmode=verify-full&sslrootcert=/run/secrets/db-ca.pem

# --- GitHub App (INSTALL.md §1) -------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The same value as the app's webhook secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# The app's private key goes in secrets/github-app.pem, not here.

# --- Encryption -------------------------------------------------------------------------------------
# Encrypts the stored GitHub tokens: openssl rand -base64 32. Changing it signs everyone out.
TOKEN_ENCRYPTION_KEY=

# --- Who can sign in (optional) ---------------------------------------------------------------------
# Only members of these GitHub organizations (comma-separated, e.g. acme,acme-labs). Leave empty to let
# any GitHub account sign in. The app must be installed on each one, with the organization
# "Members: read" permission accepted. INSTALL.md explains it.
ALLOWED_GITHUB_ORGS=
